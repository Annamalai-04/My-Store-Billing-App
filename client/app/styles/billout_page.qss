
QWidget {
    font-size: 14px;
}

QFrame#productEntryFrame,
QFrame#rightPanel {
    border: 2px solid #111;
    border-radius: 14px;
    background: white;
}

QLineEdit {
    border: 2px solid #111;
    border-radius: 8px;
    padding: 8px;
    background: white;
}

QLineEdit#searchBox {
    min-height: 36px;
}

QPushButton {
    border: 2px solid #111;
    border-radius: 8px;
    padding: 7px 14px;
    background: white;
}

QPushButton:hover {
    background: #eeeeee;
}

QPushButton#bigButton,
QPushButton#checkoutButton {
    min-height: 38px;
}

QPushButton#smallButton {
    min-height: 32px;
}

QPushButton#tableButton {
    padding: 3px 8px;
}

QTableWidget {
    border: 2px solid #111;
    gridline-color: #999;
    background: white;
}

QHeaderView::section {
    border: 1px solid #111;
    padding: 6px;
    background: white;
}
