/* =========================================================
   MAIN PAGE
   ========================================================= */

#checkHistoryPage {
    background-color: white;
}


/* =========================================================
   HISTORY PANELS
   ========================================================= */

#todayHistoryPanel,
#stockHistoryPanel {

    background-color: white;

    border: 3px solid black;

    border-radius: 16px;
}


/* =========================================================
   TITLES
   ========================================================= */

#historyTitle {

    color: black;

    font-size: 17px;

    background-color: transparent;
}


/* =========================================================
   SEARCH
   ========================================================= */

#historySearch {

    background-color: white;

    color: black;

    border: 3px solid black;

    border-radius: 6px;

    padding: 5px 10px;

    min-width: 180px;

    min-height: 25px;

    font-size: 16px;
}


/* =========================================================
   FILTER BUTTON
   ========================================================= */

#filterButton {

    background-color: white;

    color: black;

    border: 3px solid black;

    border-radius: 3px;

    padding: 5px 25px;

    min-height: 27px;

    font-size: 16px;
}


#filterButton:hover {
    background-color: #eeeeee;
}


#filterButton:pressed {
    background-color: #dddddd;
}


/* =========================================================
   TABLES
   ========================================================= */

#todayHistoryTable,
#stockHistoryTable {

    background-color: white;

    color: black;

    border: 2px solid black;

    gridline-color: black;

    font-size: 15px;
}


/* =========================================================
   TABLE HEADER
   ========================================================= */

#todayHistoryTable QHeaderView::section,
#stockHistoryTable QHeaderView::section {

    background-color: white;

    color: black;

    border: 1px solid black;

    padding: 6px;

    font-size: 15px;
}


/* =========================================================
   TABLE CELLS
   ========================================================= */

#todayHistoryTable::item,
#stockHistoryTable::item {

    background-color: white;

    color: black;

    border: 1px solid black;

    padding: 5px;
}


/* =========================================================
   CHART PANELS
   ========================================================= */

#monthlyChartPanel,
#weeklyChartPanel {

    background-color: white;

    border: 3px solid black;

    border-radius: 16px;
}


/* =========================================================
   CHART TITLE
   ========================================================= */

#chartTitle {

    color: black;

    background-color: transparent;

    font-size: 17px;
}


/* =========================================================
   COMBO BOX
   ========================================================= */

#monthlyChartPanel QComboBox,
#weeklyChartPanel QComboBox {

    background-color: white;

    color: black;

    border: 3px solid black;

    border-radius: 4px;

    padding: 3px 8px;

    min-width: 70px;

    font-size: 14px;
}