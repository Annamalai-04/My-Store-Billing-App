/* =========================================================
   PROFILE PAGE
   ========================================================= */

#profilePage {
    background-color: white;
}


/* =========================================================
   TOP PANELS
   ========================================================= */

#attendancePanel,
#profileInfoPanel {

    background-color: white;

    border: 3px solid black;

    border-radius: 16px;
}


/* =========================================================
   BOTTOM PANELS
   ========================================================= */

#weeklyLoggedPanel,
#workerHourlyPanel {

    background-color: white;

    border: 3px solid black;

    border-radius: 16px;
}


/* =========================================================
   PROFILE INPUT
   ========================================================= */

#profileEntry,
#ageEntry {

    background-color: white;

    color: black;

    border: 3px solid black;

    border-radius: 3px;

    padding: 5px;

    font-size: 15px;

    min-height: 30px;
}


#profileEntry {
    min-width: 150px;
}


#ageEntry {
    min-width: 60px;
}


/* =========================================================
   PROFILE BUTTON
   ========================================================= */

#profileButton {

    background-color: white;

    color: black;

    border: 3px solid black;

    border-radius: 3px;

    padding: 6px 18px;

    min-height: 32px;

    font-size: 15px;
}


#profileButton:hover {
    background-color: #eeeeee;
}


#profileButton:pressed {
    background-color: #dddddd;
}


/* =========================================================
   ATTENDANCE
   ========================================================= */

#attendanceValue {

    color: black;

    font-size: 20px;

    font-weight: bold;

    background-color: white;

    border: none;
}


#attendanceTitle {

    color: black;

    font-size: 16px;

    border: none;

    background-color: transparent;
}


/* =========================================================
   CHART LABELS
   ========================================================= */

#weeklyLoggedPanel QLabel,
#workerHourlyPanel QLabel {

    color: black;

    font-size: 15px;

    background-color: transparent;

    border: none;
}


/* =========================================================
   COMBO BOX
   ========================================================= */

#weeklyLoggedPanel QComboBox {

    background-color: white;

    color: black;

    border: 3px solid black;

    border-radius: 5px;

    padding: 3px 8px;

    min-width: 70px;
}


/* =========================================================
   DATE
   ========================================================= */

#workerHourlyPanel QDateEdit {

    background-color: white;

    color: black;

    border: 3px solid black;

    border-radius: 5px;

    padding: 3px 8px;

    min-width: 85px;
}