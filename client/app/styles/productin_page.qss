
QWidget {
    font-size: 14px;
}

QFrame#newPanel,
QFrame#modifyPanel,
QFrame#productViewPanel {
    border: 2px solid #111;
    border-radius: 14px;
    background: white;
}

QLineEdit {
    border: 2px solid #111;
    border-radius: 8px;
    padding: 7px;
    background: white;
}

QPushButton {
    border: 2px solid #111;
    border-radius: 8px;
    padding: 7px 14px;
    background: white;
}

QPushButton:hover {
    background: #eeeeee;
}

QTableWidget {
    border: 2px solid #111;
    gridline-color: #999;
    background: white;
}

QHeaderView::section {
    border: 1px solid #111;
    padding: 6px;
    background: white;
}

QLabel#panelTitle {
    font-weight: bold;
}
